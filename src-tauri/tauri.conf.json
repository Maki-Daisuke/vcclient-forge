{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VCClient Forge",
  "version": "../package.json",
  "identifier": "com.vcclient-forge.desktop",
  "build": {
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "./bootstrap"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["bootstrap"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../web_front/favicon.ico"]
  }
}